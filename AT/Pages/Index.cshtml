@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aesthetic Today - Beauty & Skincare</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

    <style>
        :root {
            --at-primary: #1a1a1a;
            --at-accent: #d4a373;
            --at-bg-light: #f8f9fa;
        }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .top-bar { background-color: #f5f5f5; font-size: 0.85rem; }
        .navbar-brand { font-weight: 700; letter-spacing: 1.5px; }
        .search-box input { border-radius: 20px 0 0 20px; }
        .search-box button { border-radius: 0 20px 20px 0; }
        .product-card { transition: transform 0.2s, box-shadow 0.2s; border: 1px solid #eee; cursor: pointer; }
        .product-card:hover { transform: translateY(-3px); box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .badge-discount { position: absolute; top: 10px; left: 10px; background-color: #dc3545; z-index: 2; }
        .badge-bestseller { position: absolute; top: 10px; right: 10px; background-color: var(--at-accent); z-index: 2; }
        
        /* Left Panel Filter Styling */
        .filter-sidebar {
            background-color: #ffffff;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 1.25rem;
        }
        .filter-group .list-group-item {
            border: none;
            padding: 0.6rem 0.75rem;
            border-radius: 6px !important;
            color: #495057;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .filter-group .list-group-item:hover {
            background-color: var(--at-bg-light);
            color: var(--at-primary);
        }
        .filter-group .list-group-item.active {
            background-color: var(--at-primary);
            color: #ffffff;
        }
        .filter-group .list-group-item.active .badge {
            background-color: #ffffff !important;
            color: var(--at-primary) !important;
        }

        /* Custom Pagination Styling */
        .pagination .page-link {
            color: var(--at-primary);
            border-color: #dee2e6;
            cursor: pointer;
        }
        .pagination .page-item.active .page-link {
            background-color: var(--at-primary);
            border-color: var(--at-primary);
            color: #fff;
        }
        .pagination .page-link:hover {
            color: var(--at-accent);
        }
        .mega-dropdown-parent {
            position: static !important;
        }

        .mega-dropdown-menu {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            width: 100%;
            z-index: 1050;
            border-top: 2px solid #ffc107;
        }

        .mega-dropdown-parent:hover .mega-dropdown-menu {
            display: block;
            animation: fadeIn 0.2s ease-in-out;
        }

        .hover-white:hover {
            color: #fff !important;
            text-decoration: underline !important;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .product-card {
            border: 1px solid #eaeaea;
            border-radius: 12px;
            overflow: hidden;
            background-color: #ffffff;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .product-card:hover {
            border-color: #0d6efd;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08);
        }

        .product-img-wrapper {
            position: relative;
            height: 220px;
            padding: 16px;
            background-color: #f9f9f9;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .product-img-wrapper img {
            max-height: 100%;
            width: auto;
            object-fit: contain;
            transition: opacity 0.2s ease;
        }

        .product-card:hover .product-img-wrapper img {
            opacity: 0.9;
        }

        .product-badge {
            position: absolute;
            top: 12px;
            left: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 6px;
            text-transform: uppercase;
        }

        .swiper {
            padding: 10px 10px 50px 10px;
        }

        .swiper-button-next, .swiper-button-prev {
            color: #0d6efd;
            background: #ffffff;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        }

        .swiper-button-next:after, .swiper-button-prev:after {
            font-size: 18px;
            font-weight: bold;
        }

        .swiper-pagination-bullet-active {
            background: #0d6efd;
        }

        #heroCarousel .carousel-indicators [data-bs-target] {
            width: 12px !important;
            height: 12px !important;
            border-radius: 50% !important;
            border: 0 !important;
            background-color: #000 !important;
            opacity: 0.3;
            margin: 0 5px !important;
            transition: all 0.3s ease;
        }

        #heroCarousel .carousel-indicators .active {
            opacity: 1 !important;
            transform: scale(1.25);
        }

        /* Modal Gallery Styling */
        .modal-gallery-main {
            height: 280px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f9f9f9;
            border-radius: 8px;
            padding: 10px;
        }

        .modal-gallery-main img {
            max-height: 100%;
            max-width: 100%;
            object-fit: contain;
        }

        .modal-thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: 2px solid transparent;
            border-radius: 6px;
            cursor: pointer;
            transition: border-color 0.2s ease, opacity 0.2s ease;
            opacity: 0.7;
        }

        .modal-thumb:hover, .modal-thumb.active {
            border-color: var(--at-primary);
            opacity: 1;
        }
    </style>
</head>
